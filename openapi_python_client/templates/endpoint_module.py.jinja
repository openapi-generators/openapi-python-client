def _parse_response(*, client: AuthenticatedClient | Client, response: httpx.Response) -> {{return_string}}:
    response.raise_for_status()
    {% for response in endpoint.responses.patterns %}
    {% set code_range = response.status_code.range %}
    {% if code_range[0] >= 200 and code_range[0] < 300 %}
        {% if code_range[0] == code_range[1] %}
    if response.status_code == {{ code_range[0] }}:
        {% else %}
    if {{ code_range[0] }} <= response.status_code <= {{ code_range[1] }}:
        {% endif %}
        {{ parse_response(parsed_responses, response) | indent(8) }}
    {% endif %}
    {% endfor %}
    {% if endpoint.responses.default %}
    {{ parse_response(parsed_responses, endpoint.responses.default) | indent(4) }}
    {% else %}
    raise errors.UnexpectedStatus(response.status_code, response.content)
    {% endif %}


def _build_response(*, client: AuthenticatedClient | Client, response: httpx.Response) -> Response[{{ return_string }}]:
    {% if not parsed_responses %}
    # Called for the status check alone -- it raises on an undocumented code and has no
    # value to hand back.
    _parse_response(client=client, response=response)
    {% endif %}
    return Response(
        status_code=HTTPStatus(response.status_code),
        content=response.content,
        headers=response.headers,
        {% if parsed_responses %}
        parsed=_parse_response(client=client, response=response),
        {% else %}
        parsed=None,
        {% endif %}
    )


async def _request_detailed(
    {{ arguments(endpoint) | indent(4) }}
) -> Response[{{ return_string }}]:
    {{ docstring(endpoint, return_string, is_detailed=true) | indent(4) }}

    kwargs = _get_kwargs(
        {{ kwargs(endpoint, include_client=False) }}
    )

    response = await client.get_async_httpx_client().request(
        **kwargs
    )

    return _build_response(client=client, response=response)

{# Always generated: `request` is the module's only public entry point, so gating it on
   having something to parse would leave an endpoint with no callable API at all. When
   there is no parsed body -- a 204, or FastAPI's `-> None` (an empty response schema) --
   it returns None and is called for its effect. #}
async def request (
    {{ arguments(endpoint) | indent(4) }}
) -> {{ return_string }}:
    {{ docstring(endpoint, return_string, is_detailed=false) | indent(4) }}

    {% if parsed_responses %}
    return (await _request_detailed(
        {{ kwargs(endpoint) }}
    )).parsed
    {% else %}
    await _request_detailed(
        {{ kwargs(endpoint) }}
    )
    {% endif %}

{% endif %}
