{% macro pydantic_type(property) -%}
{%- set base = property.get_type_string(no_optional=True) -%}
{%- set is_top_level_nullable = base == "None" or base.endswith(" | None") or base.startswith("None | ") -%}
{#- A union whose members carry a `Literal` tag becomes a pydantic tagged union, so validation dispatches on the
    tag instead of trying every member. Accepts the same bodies either way; see `get_discriminator_field_name`. -#}
{%- set discriminator = property.get_discriminator_field_name() -%}
{%- set declared = 'Annotated[' ~ base ~ ', Field(discriminator="' ~ discriminator ~ '")]' if discriminator else base -%}
{%- if property.required or is_top_level_nullable -%}
{{ declared }}
{%- else -%}
{{ declared }} | None
{%- endif -%}
{%- endmacro %}

{% macro declare_property(property) -%}
{%- set type_str = pydantic_type(property) -%}
{%- set has_alias = property.name != property.python_name -%}
{%- if property.required and property.default is none -%}
    {%- if has_alias -%}
{{ property.python_name }}: {{ type_str }} = Field(alias="{{ property.name }}")
    {%- else -%}
{{ property.python_name }}: {{ type_str }}
    {%- endif -%}
{%- else -%}
    {%- set default_code = property.default.python_code if property.default else "None" -%}
    {%- if has_alias -%}
{{ property.python_name }}: {{ type_str }} = Field(default={{ default_code }}, alias="{{ property.name }}")
    {%- else -%}
{{ property.python_name }}: {{ type_str }} = {{ default_code }}
    {%- endif -%}
{%- endif -%}
